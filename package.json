{
  "name": "porttos-movil",
  "version": "0.1.0",
  "author": "German Valencia",
  "description": "Porttos móvil (Android / iOS): Angular 17 + Capacitor, con los mismos temas, traducciones y recursos de la web.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "cap:sync": "ng build --configuration production && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "android:dev": "ng build --configuration android && node scripts/con-entorno.js PORTTOS_ANDROID_DEV=1 npx cap sync android",
    "ios": "npm run cap:sync && npx cap open ios",
    "test:core": "node --test ../_pruebas/movil-core.test.js ../_pruebas/movil-app.test.js"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@aparajita/capacitor-biometric-auth": "^9.0.0",
    "@aparajita/capacitor-secure-storage": "^7.1.3",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/screen-orientation": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@ngx-translate/core": "^15.0.0",
    "chart.js": "^4.6.1",
    "maplibre-gl": "^5.24.0",
    "rxjs": "~7.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@capacitor/cli": "^7.0.0",
    "typescript": "~5.2.2"
  }
}
